{
  "name": "mon-projet",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Planning personnel pour les cours, devoirs et événements.",
  "author": "Mon Planning",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop:build": "vite build --mode desktop",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:package": "npm run desktop:build && electron-builder --mac dmg",
    "preview": "vite preview",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "fr.monplanning.desktop",
    "productName": "Mon Planning",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "desktop/icon.icns"
    }
  }
}
